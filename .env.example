# Save the sample_env.txt as .env

PG_HOST = localhost
PG_PORT = 5432
PG_DB_NAME = your_database_name
PG_USER = postgres
PG_PASSWORD = your_password

# OUTPUT_DIR: Optional. If left blank or not specified, an 'output' folder in the current working directory is created.
OUTPUT_DIR = output
PG_SCHEMA = public

# Export configuration (optional)
# TABLES: Comma- or space-separated list of tables (schema.table or table)
# If left blank, tables can be provided via CLI arguments or interactive prompt.
# Example: TABLES = Allocation_Sequence, Batchwise_OrderAllocation, Projection_Order, Projection_Order_Details
TABLES = 

# ZIP_NAME: Name for the zip file / archive (with or without .zip extension)
# If left blank, can be provided via CLI arguments or interactive prompt (with timestamp fallback).
# Example: ZIP_NAME = export_bundle
ZIP_NAME = 
 