# ==============================================================================
# Git Ignore Configuration for Postgres_CSV_Exporter
# ==============================================================================

# Environment variables and sensitive credentials
.env
.env.*
!.env.example

# Python virtual environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Export outputs and data files
output/
*.csv
*.zip

# Application log files
logs/
*.log
*.logs

# Python cache and bytecode
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# Editor and OS-specific files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
desktop.ini

# Temporary files
scratch/
*.tmp